<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nuevo producto</title>
</head>
<body>
    <h2>Crear nuevo producto</h2>
    <form action="index.php?c=product&add=1" method="POST">
        <label for="name">Nombre del producto</label><br>
        <input type="text" id="name" name="name" required><br><br>

        <label for="description">Descripción</label><br>
        <textarea id="description" name="description" rows="4"></textarea><br><br>

        <label for="price">Precio</label><br>
        <input type="number" id="price" name="price" min="0" step="0.01" required><br><br>

        <label for="stock">Stock</label><br>
        <input type="number" id="stock" name="stock" min="0" step="1" required><br><br>

        <button type="submit" name="add">Crear producto</button>
    </form>
    <p><a href="index.php">Volver a la tienda</a></p>
</body>
</html>